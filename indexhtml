  <script>
    // 即時匯率核心連線與計算引擎
    let currentLiveRate = 800; // 預設備援匯率

    // 從國際公開匯率 API 抓取即時 USD -> TWD / VND 計算跨國即時匯率
    async function fetchLiveExchangeRate(isManualRefresh = false) {
      const statusText = document.getElementById('statusText');
      const rateStatus = document.getElementById('rateStatus');
      const rateDisplay = document.getElementById('rateDisplay');
      const statusDot = document.getElementById('statusDot');

      if (isManualRefresh) {
        statusText.innerText = '連線更新中...';
      }

      try {
        // 使用極速且無 CORS 限制的官方公開開放匯率節點
        const response = await fetch('https://open.er-api.com/v6/latest/TWD');
        if (!response.ok) throw new Error('API 連線異常');
        
        const data = await response.json();
        if (data && data.rates && data.rates.VND) {
          currentLiveRate = Math.round(data.rates.VND * 10) / 10;
          
          // 更新畫面顯示
          rateDisplay.innerText = currentLiveRate.toLocaleString();
          rateStatus.className = 'rate-status status-live';
          statusDot.innerText = '🟢';
          statusText.innerText = '即時匯率已連線';

          // 快取在瀏覽器中以供離線時備援
          localStorage.setItem('cached_vnd_rate', currentLiveRate);
          localStorage.setItem('cached_vnd_time', new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}));

          // 重新觸發目前的換算
          calcVNDtoNTD();
        } else {
          throw new Error('匯率資料結構錯誤');
        }
      } catch (error) {
        console.warn('無法連線至即時匯率 API，啟用快取/離線備援模式:', error);
        
        // 嘗試讀取快取
        const cachedRate = localStorage.getItem('cached_vnd_rate');
        const cachedTime = localStorage.getItem('cached_vnd_time');
        
        if (cachedRate) {
          currentLiveRate = parseFloat(cachedRate);
          statusText.innerText = `離線快取 (${cachedTime})`;
        } else {
          currentLiveRate = 800;
          statusText.innerText = '離線基準 (1:800)';
        }

        rateDisplay.innerText = currentLiveRate.toLocaleString();
        rateStatus.className = 'rate-status status-fallback';
        statusDot.innerText = '🟡';
      }
    }

    function calcVNDtoNTD() {
      const vndVal = parseFloat(document.getElementById('inputVND').value);
      if (!isNaN(vndVal) && vndVal >= 0) {
        const ntdVal = Math.round((vndVal / currentLiveRate) * 10) / 10;
        document.getElementById('inputNTD').value = ntdVal;
      } else {
        document.getElementById('inputNTD').value = '';
      }
    }

    function calcNTDtoVND() {
      const ntdVal = parseFloat(document.getElementById('inputNTD').value);
      if (!isNaN(ntdVal) && ntdVal >= 0) {
        const vndVal = Math.round(ntdVal * currentLiveRate);
        document.getElementById('inputVND').value = vndVal;
      } else {
        document.getElementById('inputVND').value = '';
      }
    }

    function quickAddVND(amount) {
      document.getElementById('inputVND').value = amount;
      calcVNDtoNTD();
    }

    function clearCalc() {
      document.getElementById('inputVND').value = '';
      document.getElementById('inputNTD').value = '';
    }

    function toggleConverterFocus() {
      const card = document.getElementById('currencyCard');
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      document.getElementById('inputVND').focus();
    }

    // 獨立精準切換函式：保證 100% 點擊秒切換
    function switchDay(targetId, btnElement) {
      var panels = document.querySelectorAll('.day-panel');
      for (var i = 0; i < panels.length; i++) {
        panels[i].classList.remove('active');
      }

      var buttons = document.querySelectorAll('.nav-tab-btn');
      for (var j = 0; j < buttons.length; j++) {
        buttons[j].classList.remove('active');
      }

      var targetPanel = document.getElementById(targetId);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }

      if (btnElement) {
        btnElement.classList.add('active');
        btnElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 頁面載入完成後自動抓取當前最新即時匯率
    document.addEventListener('DOMContentLoaded', function() {
      fetchLiveExchangeRate();
    });
  </script>
